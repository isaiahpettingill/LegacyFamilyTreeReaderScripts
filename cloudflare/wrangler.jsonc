{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "family-history-hosted-pattengills",
  "main": "worker.js",
  "compatibility_date": "2025-08-16",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  }
}
